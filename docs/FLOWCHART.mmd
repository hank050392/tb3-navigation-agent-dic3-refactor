flowchart TB
  I["任務輸入"] --> C{"取消指令？"}
  C -- "是" --> X["取消並確認結果"]
  C -- "否" --> P["解析 intent 與地點"]
  P --> V{"歧義或不合法？"}
  V -- "是" --> Q["澄清或拒絕 不派送"]
  V -- "否" --> S{"狀態新鮮且路徑有效？"}
  S -- "否" --> F["回報 NOT_READY 或 NO_PATH"]
  S -- "是" --> N["派送 Nav2"]
  N --> M{"監控任務"}
  M -- "執行中" --> M
  M -- "成功" --> R["依 action 與終點觀測回報"]
  M -- "取消 過期 逾時" --> X
  M -- "失敗" --> B{"重試額度且檢查合格？"}
  B -- "是 最多一次" --> N
  B -- "否" --> R
  X --> R
  Q --> L["紀錄事件與來源"]
  F --> L
  R --> L
